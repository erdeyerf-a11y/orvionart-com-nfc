# ORVIONART environment template — copy to .env and replace placeholders.
# Never commit or distribute the real .env file.
APP_NAME=ORVIONART
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://orvionart.example
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

# Generate a unique key after copying this file: php artisan key:generate
# Keep debug disabled outside local development.

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Current application configuration is MySQL/MariaDB-oriented (PDO MySQL required).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orvionart_staging
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_a_unique_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true

# File-backed defaults avoid requiring cache/session tables during first setup.
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
ORVIONART_ADMIN_IDLE_TIMEOUT=15

# Payment processing is intentionally disabled in this release.
ORVIONART_PAYMENTS_ENABLED=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@orvionart.example"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Redis configuration (leave unused unless explicitly configured).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Search engine indexing is opt-in. Set true only for the approved public production site.
ORVIONART_PUBLIC_INDEXING_ENABLED=false

# Optional video metadata/codec verification; install FFprobe on the server.
ORVIONART_FFPROBE_BINARY=ffprobe
ORVIONART_FFMPEG_BINARY=ffmpeg
ORVIONART_VIDEO_TRANSCODING_ENABLED=true
ORVIONART_FFPROBE_TIMEOUT_SECONDS=90
ORVIONART_FFMPEG_TIMEOUT_SECONDS=240
